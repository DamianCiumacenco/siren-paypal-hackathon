# PayPal (used by both @paypal/agent-toolkit AND our webhook verifier)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
# true = accept Webhook Simulator events (testing only, keep off in production)
PAYPAL_WEBHOOK_ALLOW_SIMULATOR=

# Telegram
TELEGRAM_BOT_TOKEN=

# LLM (Vercel AI SDK providers)
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Only needed by `npm run db:push` (Supabase → Connect → Session pooler URI, percent-encoded)
SUPABASE_DB_URL=

# App
PORT=3000
PUBLIC_URL=
