# PayPal (used by both @paypal/agent-toolkit AND our webhook verifier)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
# true = accept Webhook Simulator events (testing only, keep off in production)
PAYPAL_WEBHOOK_ALLOW_SIMULATOR=

# Telegram
TELEGRAM_BOT_TOKEN=

# LLM (Vercel AI SDK providers)
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Fallback 1 (when Groq's daily quota is gone / Groq is down)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Fallback 2: NVIDIA NIM free dev key (nvapi-…), OpenAI-compatible endpoint
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Only needed by `npm run db:push` (Supabase → Connect → Session pooler URI, percent-encoded)
SUPABASE_DB_URL=

# Autonomous nag scheduler: every 6h in prod; '*/5 * * * *' for a live demo/test
NAG_CRON_INTERVAL=0 */6 * * *

# App
PORT=3000
# Production only (Render): https://<service>.onrender.com → Telegram webhook mode. Leave blank locally.
PUBLIC_URL=
# Local only: take Telegram over from a live production webhook (normally leave unset)
TELEGRAM_FORCE_POLLING=
